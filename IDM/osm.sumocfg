<?xml version="1.0" encoding="UTF-8"?>
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="osm.net.xml"/>
        <route-files value="osm_pt.rou.xml,routes_24h.rou.xml"/>
        <additional-files value="osm_polygons.add.xml,osm_stops.add.xml,osm_complete_parking_areas.add.xml,osm_parking_rerouters.add.xml,osm_taxi_stands.add.xml,osm_taxi_rerouters.add.xml"/>
    </input>

    <time>
        <begin value="0.0"/>
        <step-length value="1"/>
        <end value="86400.0"/>
    </time>

    <output>
        <output-prefix value="output."/>
    </output>

    <processing>
        <ignore-route-errors value="true"/>
        <time-to-teleport.disconnected value="1"/>
    </processing>

    <report>
        <error-log value="error.log"/>
        <no-warnings value="false"/>
    </report>

    <gui_only>
        <gui-settings-file value="default-gui.xml" />
    </gui_only>

</sumoConfiguration>
