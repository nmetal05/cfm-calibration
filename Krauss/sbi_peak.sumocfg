<?xml version="1.0" encoding="UTF-8"?>
<sumoConfiguration>
    <input>
        <net-file value="osm.net.xml"/>
        <route-files value="routes_peak_novtype.rou.xml"/>
    </input>

    <time>
        <begin value="61200.0"/>
        <end value="68400.0"/>
        <step-length value="1"/>
    </time>

    <processing>
        <ignore-route-errors value="true"/>
        <time-to-teleport value="300"/>
    </processing>

    <report>
        <no-warnings value="true"/>
        <no-step-log value="true"/>
        <verbose value="false"/>
    </report>
</sumoConfiguration>